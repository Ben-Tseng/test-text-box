function autoClickFlow() {

    const observer = new MutationObserver(() => {

        const outcomeBtn = document.querySelector('.outcome-button');
        if (outcomeBtn && !outcomeBtn.dataset.clicked) {
            outcomeBtn.dataset.clicked = "true";
            outcomeBtn.click();
            console.log("Outcome clicked");
        }

        const submitBtn = document.querySelector('#submit');
        if (submitBtn) {
            submitBtn.click();
            observer.disconnect();
        }

    });

    observer.observe(document.body, {
        childList: true,
        subtree: true
    });
}

autoClickFlow();
