(async function () {
  const radioSelector = 'input[value="OTHER"]';
  const textareaId = 'calypso_bl_legitimacy_question_calypso_override_other';
  const text = 'fail';

  const sleep = ms => new Promise(r => setTimeout(r, ms));

  async function runInDoc(doc, where) {
    const radio = doc.querySelector(radioSelector);
    const ta = doc.getElementById(textareaId);
    if (!radio || !ta) return false;

    radio.click();
    radio.checked = true;
    radio.dispatchEvent(new Event('input', { bubbles: true }));
    radio.dispatchEvent(new Event('change', { bubbles: true }));

    await sleep(300);

    ta.focus();
    ta.value = text;
    ta.dispatchEvent(new Event('input', { bubbles: true }));
    ta.dispatchEvent(new Event('change', { bubbles: true }));

    console.log('done in', where, {
      radioChecked: radio.checked,
      value: ta.value
    });
    return true;
  }

  if (await runInDoc(document, 'top')) return;

  const frames = document.querySelectorAll('iframe');
  for (let i = 0; i < frames.length; i++) {
    try {
      const doc = frames[i].contentDocument || frames[i].contentWindow.document;
      if (doc && await runInDoc(doc, `iframe[${i}]`)) return;
    } catch (e) {}
  }

  console.log('not found');
})();
